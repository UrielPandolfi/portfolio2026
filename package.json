{
  "name": "the-stoic-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run assets:prepare",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run assets:prepare",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
